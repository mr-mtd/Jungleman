extends Node
## Background music and sound effects. Every sound is generated by
## tools/generate_audio.py into assets/audio/.
##
##   Audio.play("jump")                  plain one-shot
##   Audio.play_at("snap", global_pos)   positional; fades with distance from the camera
##   Audio.play_music() / Audio.stop_music()

const MUSIC := preload("res://assets/audio/music/jungle_theme.ogg")
const SFX_DIR := "res://assets/audio/sfx/"
const SOUND_NAMES := [
	"jump", "land", "hurt", "die", "whip", "throw", "hit", "enemy_die",
	"gold", "stones", "health", "life", "checkpoint", "vine", "zipline",
	"tar", "splash", "plank", "snake", "snap", "level_complete", "game_over", "pause",
]
const VOICES := 12
const MUSIC_DB := -9.0
const SFX_DB := -3.0
const MAX_DISTANCE := 420.0  ## positional sounds farther than this from the camera are skipped

var _sounds := {}
var _players: Array[AudioStreamPlayer] = []
var _players_2d: Array[AudioStreamPlayer2D] = []
var _next := 0
var _next_2d := 0
var _music: AudioStreamPlayer
var _music_tween: Tween


func _ready() -> void:
	# keep playing (and allow the pause blip) while the game is paused
	process_mode = Node.PROCESS_MODE_ALWAYS
	_add_bus("Music", MUSIC_DB)
	_add_bus("SFX", SFX_DB)
	for n in SOUND_NAMES:
		_sounds[n] = load(SFX_DIR + n + ".wav")
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_players.append(p)
		var p2 := AudioStreamPlayer2D.new()
		p2.bus = "SFX"
		p2.max_distance = MAX_DISTANCE
		p2.attenuation = 1.6
		add_child(p2)
		_players_2d.append(p2)
	var stream: AudioStreamOggVorbis = MUSIC
	stream.loop = true
	_music = AudioStreamPlayer.new()
	_music.stream = stream
	_music.bus = "Music"
	add_child(_music)


func _add_bus(bus_name: String, volume_db: float) -> void:
	if AudioServer.get_bus_index(bus_name) != -1:
		return
	AudioServer.add_bus()
	var idx := AudioServer.bus_count - 1
	AudioServer.set_bus_name(idx, bus_name)
	AudioServer.set_bus_send(idx, "Master")
	AudioServer.set_bus_volume_db(idx, volume_db)


## Plays a sound effect. A little random pitch keeps repeated sounds lively.
func play(sound: String, volume_db := 0.0, pitch_jitter := 0.06) -> void:
	var p := _players[_next]
	_next = (_next + 1) % VOICES
	_start(p, sound, volume_db, pitch_jitter)


## Plays a sound at a world position; quiet or silent when it's far off-screen.
func play_at(sound: String, pos: Vector2, volume_db := 0.0, pitch_jitter := 0.06) -> void:
	var cam := get_viewport().get_camera_2d()
	if cam and cam.get_screen_center_position().distance_to(pos) > MAX_DISTANCE:
		return
	var p := _players_2d[_next_2d]
	_next_2d = (_next_2d + 1) % VOICES
	p.global_position = pos
	_start(p, sound, volume_db, pitch_jitter)


func _start(p: Node, sound: String, volume_db: float, pitch_jitter: float) -> void:
	if not _sounds.has(sound):
		push_warning("Unknown sound: " + sound)
		return
	p.stream = _sounds[sound]
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()


## Starts the jungle theme (no-op if it's already playing).
func play_music(fade_in := 1.5) -> void:
	if _music_tween:
		_music_tween.kill()
	if not _music.playing:
		_music.volume_db = -40.0
		_music.play()
	_music_tween = create_tween()
	_music_tween.tween_property(_music, "volume_db", 0.0, fade_in)


func stop_music(fade_out := 1.0) -> void:
	if _music_tween:
		_music_tween.kill()
	_music_tween = create_tween()
	_music_tween.tween_property(_music, "volume_db", -40.0, fade_out)
	_music_tween.tween_callback(_music.stop)
